APP_ADDR=:8080

# postgres://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=disable
# This default matches docker-compose.yml; point it at your own Postgres if you have one.
DATABASE_URL=postgres://govfac:govfac@localhost:5434/govfac?sslmode=disable

SESSION_TTL=168h

# Frontend page that receives ?token= from the reset email.
PASSWORD_RESET_URL=http://localhost:3000/reset-password

# Leave SMTP_HOST empty locally and reset emails are printed to the server log.
# For Gmail: smtp.gmail.com, port 587, and an App Password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=GovFac Report <no-reply@govfac.local>
